{
    "recipes": [
        {
            "name": "RemoveRuntimeTraceCalls",
            "description": "Delete calls to the deprecated Runtime.traceInstructions(...) and traceMethodCalls(...) methods.",
            "steps": [
                {
                    "match": {
                        "nodeType": "ExpressionStmt",
                        "matchExpr": "traceInstructions\\s*\\("
                    },
                    "actions": [
                        {
                            "removeNode": {}
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "ExpressionStmt",
                        "matchExpr": "traceMethodCalls\\s*\\("
                    },
                    "actions": [
                        {
                            "removeNode": {}
                        }
                    ]
                }
            ]
        },
        {
            "name": "UseLongThreadID",
            "description": "Rename LogRecord thread-ID methods to their Java 17 replacements and update return types.",
            "rollbackOnError": "OverrideRule",
            "steps": [
                {
                    "match": {
                        "nodeType": "MethodCallExpr",
                        "methodName": "getThreadID"
                    },
                    "actions": [
                        {
                            "renameMethodCall": {
                                "oldName": "getThreadID",
                                "newName": "getLongThreadID"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodCallExpr",
                        "methodName": "setThreadID"
                    },
                    "actions": [
                        {
                            "renameMethodCall": {
                                "oldName": "setThreadID",
                                "newName": "setLongThreadID"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "VariableDeclarationExpr",
                        "matchExpr": "getLongThreadID\\s*\\("
                    },
                    "actions": [
                        {
                            "changeType": {
                                "newType": "long"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "declaringFqn": "java.util.logging.LogRecord",
                        "methodName": "getThreadID"
                    },
                    "actions": [
                        {
                            "renameMethod": {
                                "newName": "getLongThreadID"
                            }
                        },
                        {
                            "changeMethodReturnType": {
                                "newType": "long"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "declaringFqn": "java.util.logging.LogRecord",
                        "methodName": "setThreadID"
                    },
                    "actions": [
                        {
                            "renameMethod": {
                                "newName": "setLongThreadID"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "ReplaceDeprecatedCertPackage",
            "description": "Replace javax.security.cert with java.security.cert",
            "steps": [
                {
                    "match": {
                        "nodeType": "ImportDeclaration",
                        "matchExpr": "javax\\.security\\.cert"
                    },
                    "actions": [
                        {
                            "replacePackage": {
                                "oldPackage": "javax.security.cert",
                                "newPackage": "java.security.cert"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "ClassOrInterfaceType",
                        "matchExpr": "javax\\.security\\.cert"
                    },
                    "actions": [
                        {
                            "replacePackage": {
                                "oldPackage": "javax.security.cert",
                                "newPackage": "java.security.cert"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "MakeAgentEntryPointsPublic",
            "description": "Ensure premain/agentmain entry-points are declared public so the JVM can load the agent.",
            "steps": [
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "methodName": "premain",
                        "paramCount": 1
                    },
                    "actions": [
                        {
                            "setAccessLevel": {
                                "level": "public"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "methodName": "premain",
                        "paramCount": 2
                    },
                    "actions": [
                        {
                            "setAccessLevel": {
                                "level": "public"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "methodName": "agentmain",
                        "paramCount": 1
                    },
                    "actions": [
                        {
                            "setAccessLevel": {
                                "level": "public"
                            }
                        }
                    ]
                },
                {
                    "match": {
                        "nodeType": "MethodDeclaration",
                        "methodName": "agentmain",
                        "paramCount": 2
                    },
                    "actions": [
                        {
                            "setAccessLevel": {
                                "level": "public"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "RemoveCountStackFrames",
            "description": "Remove standalone calls to Thread.countStackFrames() (Java SE 14+).",
            "steps": [
                {
                    "match": {
                        "nodeType": "MethodCallExpr",
                        "methodName": "countStackFrames",
                        "parentNodeType": "ExpressionStmt"
                    },
                    "actions": [
                        {
                            "removeParentNode": {}
                        }
                    ]
                }
            ]
        }
    ]
}