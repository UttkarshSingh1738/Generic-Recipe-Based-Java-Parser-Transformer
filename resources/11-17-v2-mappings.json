{
    "recipes": [
        {
            "name": "UseInstanceOfPatternMatching",
            "description": "Convert old‐style instanceof+cast into Java 17 pattern matching",
            "rollbackOnError": "PatternVariableUsageRule",
            "steps": [
                {
                    "match": {
                        "nodeType": "InstanceOfExpr"
                    },
                    "actions": [
                        {
                            "instanceOfToPattern": {}
                        }
                    ]
                }
            ]
        },
        {
            "name": "PreferStringFormatted",
            "description": "Use Java 17 String.formatted(...) instead of String.format(...)",
            "steps": [
                {
                    "match": {
                        "nodeType": "MethodCallExpr",
                        "scopePattern": "String",
                        "methodName": "format"
                    },
                    "actions": [
                        {
                            "replaceStringFormatWithFormatted": {
                                "parenthesizeFirstArg": true
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "UseTextBlock",
            "description": "Convert string literals to text blocks where applicable",
            "steps": [
                {
                    "match": {
                        "nodeType": "BinaryExpr",
                        "operator": "+",
                        "literalOnly": true
                    },
                    "actions": [
                        {
                            "collapseLiteralConcat": {
                                "stringsWithoutNewlines": "false"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "AnnotateSerialVersionUIDWithSerial",
            "description": "Add `@Serial` to any `serialVersionUID` field (Java 14+).",
            "steps": [
                {
                    "match": {
                        "nodeType": "FieldDeclaration",
                        "matchExpr": "serialVersionUID"
                    },
                    "actions": [
                        {
                            "addImport": {
                                "name": "java.io.Serial"
                            }
                        },
                        {
                            "addAnnotation": {
                                "name": "Serial"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}